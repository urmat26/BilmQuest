// Cloudflare Workers: static assets of the built app with SPA fallback.
// Deploy: npx wrangler deploy (after `vite build`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bilmquest",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
